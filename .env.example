# Recommended: bash scripts/init-local-env.sh generates unique local passwords.
# This file is documentation only; replace placeholders before use.
POSTGRES_PORT=5432
POSTGRES_PASSWORD='REPLACE_WITH_ADMIN_PASSWORD'
POSTGRES_APP_PASSWORD='REPLACE_WITH_APP_PASSWORD'
POSTGRES_MIGRATOR_PASSWORD='REPLACE_WITH_MIGRATION_PASSWORD'
POSTGRES_TEST_PASSWORD='REPLACE_WITH_TEST_PASSWORD'
# scripts/database-env.sh constructs connection strings from the values above.
# ConnectionStrings__Default / SPLIT_MIGRATION_CONNECTION / SPLIT_TEST_CONNECTION
# may instead be explicitly set for external PostgreSQL (use SSL Mode=VerifyFull).
Authentication__Google__ClientId=''
Authentication__Google__ClientSecret=''
