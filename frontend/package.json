{
  "name": "split-together",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --ssl-cert ../.cert/localhost.crt --ssl-key ../.cert/localhost.key --proxy-config proxy.conf.json",
